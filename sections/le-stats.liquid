{%- assign s = section.settings -%}
<style>
  #le-st-{{ section.id }} { background: {{ s.bg_color }}; color: {{ s.text_color }}; }
  #le-st-{{ section.id }} .le-eyebrow { color: {{ s.accent_color }}; }
  #le-st-{{ section.id }} .le-lead { color: inherit; opacity: .8; }
  #le-st-{{ section.id }} .le-st__grid { display: grid; grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 4 }}, minmax(0, 1fr)); gap: 24px; }
  #le-st-{{ section.id }} .le-st__card { background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.16); border-radius: var(--le-radius); padding: 36px 28px; text-align: center; }
  #le-st-{{ section.id }} .le-st__num { font-size: 72px; font-weight: 800; line-height: 1; letter-spacing: -1.5px; color: {{ s.accent_color }}; margin: 0 0 14px; }
  #le-st-{{ section.id }} .le-st__label { font-size: 18px; font-weight: 600; line-height: 1.4; margin: 0; }
  #le-st-{{ section.id }} .le-st__note { font-size: 13px; opacity: .65; text-align: center; margin: 28px 0 0; }
  @media (max-width: 767px) {
    #le-st-{{ section.id }} .le-st__grid { grid-template-columns: 1fr; gap: 14px; }
    #le-st-{{ section.id }} .le-st__card { padding: 26px 20px; }
    #le-st-{{ section.id }} .le-st__num { font-size: 56px; }
    #le-st-{{ section.id }} .le-st__label { font-size: 16px; }
  }
</style>
<div id="le-st-{{ section.id }}" class="le-sec">
  <div class="le-wrap">
    <div class="le-head le-center">
      {%- if s.eyebrow != blank -%}<p class="le-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="le-h2">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.subheading != blank -%}<p class="le-lead">{{ s.subheading }}</p>{%- endif -%}
    </div>
    <div class="le-st__grid">
      {%- for block in section.blocks -%}
        <div class="le-st__card" {{ block.shopify_attributes }}>
          <p class="le-st__num">{{ block.settings.number }}</p>
          <p class="le-st__label">{{ block.settings.label }}</p>
        </div>
      {%- endfor -%}
    </div>
    {%- if s.note != blank -%}<p class="le-st__note">{{ s.note }}</p>{%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "LE Stats",
  "tag": "section",
  "class": "t4s-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The results are in" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Families can taste the difference" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "note", "label": "Footnote" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#5c1717" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Number color", "default": "#ffd166" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "96%" },
        { "type": "textarea", "id": "label", "label": "Label", "default": "said it tastes just like home" }
      ]
    }
  ],
  "presets": [{ "name": "LE Stats", "blocks": [{ "type": "stat" }, { "type": "stat" }, { "type": "stat" }] }]
}
{% endschema %}
