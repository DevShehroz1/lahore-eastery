{%- assign s = section.settings -%}
<style>
  #le-faq-{{ section.id }} { background: {{ s.bg_color }}; }
  #le-faq-{{ section.id }} .le-faq__list { max-width: 820px; margin: 0 auto; }
  #le-faq-{{ section.id }} details { border-bottom: 1px solid rgba(0,31,16,.14); }
  #le-faq-{{ section.id }} summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 24px 0; font-size: 20px; font-weight: 700; color: var(--le-ink); }
  #le-faq-{{ section.id }} summary::-webkit-details-marker { display: none; }
  #le-faq-{{ section.id }} .le-faq__icon { flex: 0 0 32px; height: 32px; border-radius: 50%; background: var(--le-mint); color: var(--le-green); display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 700; transition: transform .2s ease; }
  #le-faq-{{ section.id }} details[open] .le-faq__icon { transform: rotate(45deg); }
  #le-faq-{{ section.id }} .le-faq__answer { padding: 0 48px 24px 0; font-size: 16px; line-height: 1.65; color: var(--le-ink-soft); }
  #le-faq-{{ section.id }} .le-faq__answer p { margin: 0 0 10px; }
  @media (max-width: 767px) {
    #le-faq-{{ section.id }} summary { font-size: 17px; padding: 18px 0; }
    #le-faq-{{ section.id }} .le-faq__answer { padding-right: 0; font-size: 15px; }
  }
</style>
<div id="le-faq-{{ section.id }}" class="le-sec">
  <div class="le-wrap">
    <div class="le-head le-center">
      {%- if s.eyebrow != blank -%}<p class="le-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="le-h2">{{ s.heading }}</h2>{%- endif -%}
    </div>
    <div class="le-faq__list">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}{% if forloop.first and s.open_first %} open{% endif %}>
          <summary>{{ block.settings.question }}<span class="le-faq__icon" aria-hidden="true">+</span></summary>
          <div class="le-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "LE FAQ",
  "tag": "section",
  "class": "t4s-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions? We've got answers." },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": true },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does delivery take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Most orders arrive within 24–48 hours.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "LE FAQ", "blocks": [{ "type": "question" }, { "type": "question" }] }]
}
{% endschema %}
