    "custom_liquid_mmHxfh": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<section id=\"shopify-section-reels\" class=\"shopify-section section\">\n  <style>\n    .reels-container {\n      display: flex;\n      overflow-x: auto;\n      scroll-snap-type: x mandatory;\n      gap: 12px;\n      padding: 10px 6px;\n      width: 100%;\n      height: auto;\n    }\n\n    .video-wrapper {\n      position: relative;\n      flex: 0 0 auto;\n      width: 260px;\n      height: 380px;\n      border-radius: 12px;\n      overflow: hidden;\n    }\n\n    .reels-container video {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      background: #000;\n      border-radius: 12px;\n      pointer-events: none;\n    }\n\n    .play-pause-btn {\n      position: absolute;\n      top: 50%;\n      left: 50%;\n      transform: translate(-50%, -50%);\n      background: rgba(0, 0, 0, 0.6);\n      border: none;\n      border-radius: 50%;\n      width: 50px;\n      height: 50px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      transition: opacity 0.3s ease;\n    }\n\n    .play-pause-btn i {\n      color: white;\n      font-size: 24px;\n      display: block;\n    }\n\n    .video-wrapper:hover .play-pause-btn {\n      opacity: 1;\n    }\n\n    .reels-container::-webkit-scrollbar {\n      display: none;\n    }\n\n    @media screen and (max-width: 768px) {\n      .reels-container {\n        overflow-x: scroll;\n        padding: 10px 12px;\n        justify-content: start;\n      }\n\n      .video-wrapper {\n        width: 66vw;\n        height: 55vh;\n      }\n    }\n  </style>\n\n  <div class=\"color-background-1 gradient\">\n    <div class=\"reels-container\">\n      <div class=\"video-wrapper\">\n        <video muted playsinline preload=\"auto\">\n          <source src=\"https://cdn.shopify.com/videos/c/o/v/07597913484e483d9b0a5a9819fedcbd.mp4\" type=\"video/mp4\">\n        </video>\n        <button class=\"play-pause-btn\"><i class=\"fa-solid fa-play\"></i></button>\n      </div>\n\n      <div class=\"video-wrapper\">\n        <video muted playsinline preload=\"auto\">\n          <source src=\"https://cdn.shopify.com/videos/c/o/v/cbbc379d7ee34019b3774e4b70749d37.mp4\" type=\"video/mp4\">\n        </video>\n        <button class=\"play-pause-btn\"><i class=\"fa-solid fa-play\"></i></button>\n      </div>\n\n      <div class=\"video-wrapper\">\n        <video muted playsinline preload=\"auto\">\n          <source src=\"https://cdn.shopify.com/videos/c/o/v/3b1663ec9aad4495825dab6e977cece3.mp4\" type=\"video/mp4\">\n        </video>\n        <button class=\"play-pause-btn\"><i class=\"fa-solid fa-play\"></i></button>\n      </div>\n\n      <div class=\"video-wrapper\">\n        <video muted playsinline preload=\"auto\">\n          <source src=\"https://cdn.shopify.com/videos/c/o/v/f2b260c4542c4cadaea53c6ac2ecd6ac.mp4\" type=\"video/mp4\">\n        </video>\n        <button class=\"play-pause-btn\"><i class=\"fa-solid fa-play\"></i></button>\n      </div>\n\n      <div class=\"video-wrapper\">\n        <video muted playsinline preload=\"auto\">\n          <source src=\"https://cdn.shopify.com/videos/c/o/v/83a9d5b35c5a4fd4afba3e3a5e25f90e.mp4\" type=\"video/mp4\">\n        </video>\n        <button class=\"play-pause-btn\"><i class=\"fa-solid fa-play\"></i></button>\n      </div>\n    </div>\n  </div>\n\n  <script>\n    const videoWrappers = document.querySelectorAll('.video-wrapper');\n\n    videoWrappers.forEach(wrapper => {\n      const video = wrapper.querySelector('video');\n      const button = wrapper.querySelector('.play-pause-btn');\n      const icon = button.querySelector('i');\n\n      button.addEventListener('click', () => {\n        if (video.paused) {\n          // Pause all other videos before playing the clicked one\n          videoWrappers.forEach(otherWrapper => {\n            const otherVideo = otherWrapper.querySelector('video');\n            const otherIcon = otherWrapper.querySelector('.play-pause-btn i');\n\n            if (otherVideo !== video) {\n              otherVideo.pause();\n              otherIcon.classList.remove('fa-pause');\n              otherIcon.classList.add('fa-play');\n            }\n          });\n\n          video.muted = false; // Unmute when playing\n          video.play();\n          icon.classList.remove('fa-play');\n          icon.classList.add('fa-pause');\n        } else {\n          video.pause();\n          icon.classList.remove('fa-pause');\n          icon.classList.add('fa-play');\n        }\n      });\n\n      // Auto-update icon when video is played/paused\n      video.addEventListener('play', () => {\n        icon.classList.remove('fa-play');\n        icon.classList.add('fa-pause');\n      });\n\n      video.addEventListener('pause', () => {\n        icon.classList.remove('fa-pause');\n        icon.classList.add('fa-play');\n      });\n    });\n  </script>\n\n  <!-- Updated FontAwesome Link -->\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n</section>",
