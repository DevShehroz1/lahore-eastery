{% liquid
  assign s = section.settings
  assign sid = section.id
%}

<style>
  #le-vp-{{ sid }} {
    background: {{ s.bg_color }};
    padding: 64px 24px;
  }
  #le-vp-{{ sid }} .le-vp__inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  #le-vp-{{ sid }} .le-vp__heading {
    font-family: "Work Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 36px;
    font-weight: 800;
    color: rgba(0,31,16,0.949);
    text-align: center;
    margin: 0 0 48px;
    line-height: 1.15;
  }
  #le-vp-{{ sid }} .le-vp__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  #le-vp-{{ sid }} .le-vp__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  #le-vp-{{ sid }} .le-vp__card-img {
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 4/3;
    background: #f0ede0;
  }
  #le-vp-{{ sid }} .le-vp__card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #le-vp-{{ sid }} .le-vp__card-emoji {
    width: 100%;
    aspect-ratio: 4/3;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 72px;
    background: {{ s.card_bg }};
    border-radius: 16px;
  }
  #le-vp-{{ sid }} .le-vp__card-title {
    font-family: "Work Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 22px;
    font-weight: 800;
    color: rgba(0,31,16,0.949);
    margin: 0;
  }
  #le-vp-{{ sid }} .le-vp__card-body {
    font-family: "Work Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 16px;
    color: rgba(0,31,16,0.7);
    line-height: 1.6;
    margin: 0;
  }
  @media (max-width: 768px) {
    #le-vp-{{ sid }} .le-vp__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    #le-vp-{{ sid }} .le-vp__heading { font-size: 26px; margin-bottom: 32px; }
  }
</style>

<div id="le-vp-{{ sid }}">
  <div class="le-vp__inner">
    {%- if s.heading != blank -%}
      <h2 class="le-vp__heading">{{ s.heading }}</h2>
    {%- endif -%}

    <div class="le-vp__grid">
      {%- for i in (1..3) -%}
        {%- liquid
          assign img_key   = 'card_' | append: i | append: '_image'
          assign emoji_key = 'card_' | append: i | append: '_emoji'
          assign title_key = 'card_' | append: i | append: '_title'
          assign body_key  = 'card_' | append: i | append: '_body'
          assign img   = s[img_key]
          assign emoji = s[emoji_key]
          assign title = s[title_key]
          assign body  = s[body_key]
        -%}
        <div class="le-vp__card">
          {%- if img != blank -%}
            <div class="le-vp__card-img">
              {{ img | image_url: width: 700 | image_tag: loading: 'lazy', widths: '400,700' }}
            </div>
          {%- elsif emoji != blank -%}
            <div class="le-vp__card-emoji">{{ emoji }}</div>
          {%- endif -%}
          {%- if title != blank -%}<h3 class="le-vp__card-title">{{ title }}</h3>{%- endif -%}
          {%- if body != blank -%}<p class="le-vp__card-body">{{ body }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "LE Value Props",
  "tag": "section",
  "class": "t4s-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading", "default": "Why Lahore Eatery?" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#faf6e4" },
    { "type": "color", "id": "card_bg", "label": "Emoji card background", "default": "#f0ede0" },
    { "type": "header", "content": "Card 1" },
    { "type": "image_picker", "id": "card_1_image", "label": "Image (overrides emoji)" },
    { "type": "text", "id": "card_1_emoji", "label": "Emoji (if no image)", "default": "🥙" },
    { "type": "text", "id": "card_1_title", "label": "Title", "default": "Freshly Prepared" },
    { "type": "textarea", "id": "card_1_body", "label": "Description", "default": "Made fresh in our kitchen and frozen to lock in taste, texture, and nutrition — straight to your door." },
    { "type": "header", "content": "Card 2" },
    { "type": "image_picker", "id": "card_2_image", "label": "Image (overrides emoji)" },
    { "type": "text", "id": "card_2_emoji", "label": "Emoji (if no image)", "default": "✅" },
    { "type": "text", "id": "card_2_title", "label": "Title", "default": "100% Halal" },
    { "type": "textarea", "id": "card_2_body", "label": "Description", "default": "Every single ingredient we use is certified Halal. No compromises, no shortcuts — ever." },
    { "type": "header", "content": "Card 3" },
    { "type": "image_picker", "id": "card_3_image", "label": "Image (overrides emoji)" },
    { "type": "text", "id": "card_3_emoji", "label": "Emoji (if no image)", "default": "🚚" },
    { "type": "text", "id": "card_3_title", "label": "Title", "default": "Delivered in 48hrs" },
    { "type": "textarea", "id": "card_3_body", "label": "Description", "default": "Order today and receive your fresh frozen snacks within 24–48 hours anywhere in Pakistan." }
  ],
  "presets": [{ "name": "LE Value Props" }]
}
{% endschema %}
