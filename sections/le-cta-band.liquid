{%- assign s = section.settings -%}
<style>
  #le-cta-{{ section.id }} { background: {{ s.outer_bg }}; padding: 32px 0 88px; }
  #le-cta-{{ section.id }} .le-cta__box { background: {{ s.bg_color }}; color: {{ s.text_color }}; border-radius: 32px; padding: 72px 32px; text-align: center; position: relative; overflow: hidden; }
  #le-cta-{{ section.id }} .le-cta__box .le-lead { color: inherit; opacity: .85; margin-bottom: 32px; }
  #le-cta-{{ section.id }} .le-cta__emoji { font-size: 44px; line-height: 1; margin-bottom: 16px; }
  #le-cta-{{ section.id }} .le-cta__trust { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px 24px; margin-top: 22px; font-size: 14px; font-weight: 600; opacity: .9; }
  @media (max-width: 767px) {
    #le-cta-{{ section.id }} { padding: 16px 0 56px; }
    #le-cta-{{ section.id }} .le-cta__box { padding: 48px 20px; border-radius: 24px; }
  }
</style>
<div id="le-cta-{{ section.id }}" class="le-sec">
  <div class="le-wrap">
    <div class="le-cta__box">
      {%- if s.emoji != blank -%}<div class="le-cta__emoji" aria-hidden="true">{{ s.emoji }}</div>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="le-h2">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.subheading != blank -%}<p class="le-lead">{{ s.subheading }}</p>{%- endif -%}
      {%- if s.cta_text != blank -%}<a href="{{ s.cta_link | default: '/collections/all' }}" class="le-btn le-btn--light">{{ s.cta_text }}</a>{%- endif -%}
      {%- if s.trust != blank -%}
        <div class="le-cta__trust">
          {%- assign items = s.trust | split: '|' -%}
          {%- for item in items -%}<span>✓ {{ item | strip }}</span>{%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "LE CTA Band",
  "tag": "section",
  "class": "t4s-section",
  "settings": [
    { "type": "text", "id": "emoji", "label": "Emoji", "default": "🥟" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to taste Lahore?" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Order now" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "trust", "label": "Trust points (separate with |)", "default": "100% Halal | Delivered in 48hrs | Cash on delivery" },
    { "type": "color", "id": "bg_color", "label": "Box background", "default": "#007E40" },
    { "type": "color", "id": "text_color", "label": "Box text", "default": "#ffffff" },
    { "type": "color", "id": "outer_bg", "label": "Section background", "default": "#ffffff" }
  ],
  "presets": [{ "name": "LE CTA Band" }]
}
{% endschema %}
