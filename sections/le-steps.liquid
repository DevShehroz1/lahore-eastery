{%- assign s = section.settings -%}
<style>
  #le-steps-{{ section.id }} { background: {{ s.bg_color }}; }
  #le-steps-{{ section.id }} .le-steps__grid { display: grid; grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 4 }}, minmax(0, 1fr)); gap: 24px; counter-reset: le-step; }
  #le-steps-{{ section.id }} .le-steps__card { background: #fff; border-radius: var(--le-radius); padding: 32px 28px; position: relative; }
  #le-steps-{{ section.id }} .le-steps__num { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 50%; background: var(--le-green); color: #fff; font-size: 20px; font-weight: 800; margin-bottom: 20px; }
  #le-steps-{{ section.id }} .le-steps__icon { position: absolute; top: 28px; right: 28px; font-size: 36px; }
  #le-steps-{{ section.id }} .le-steps__title { font-size: 22px; font-weight: 800; margin: 0 0 8px; }
  #le-steps-{{ section.id }} .le-steps__body { font-size: 16px; line-height: 1.55; color: var(--le-ink-soft); margin: 0; }
  #le-steps-{{ section.id }} .le-steps__cta { text-align: center; margin-top: 40px; }
  @media (max-width: 767px) {
    #le-steps-{{ section.id }} .le-steps__grid { grid-template-columns: 1fr; gap: 14px; }
    #le-steps-{{ section.id }} .le-steps__card { padding: 24px 20px; }
  }
</style>
<div id="le-steps-{{ section.id }}" class="le-sec">
  <div class="le-wrap">
    <div class="le-head le-center">
      {%- if s.eyebrow != blank -%}<p class="le-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="le-h2">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.subheading != blank -%}<p class="le-lead">{{ s.subheading }}</p>{%- endif -%}
    </div>
    <div class="le-steps__grid">
      {%- for block in section.blocks -%}
        <div class="le-steps__card" {{ block.shopify_attributes }}>
          <span class="le-steps__num">{{ forloop.index }}</span>
          {%- if block.settings.icon != blank -%}<span class="le-steps__icon" aria-hidden="true">{{ block.settings.icon }}</span>{%- endif -%}
          <h3 class="le-steps__title">{{ block.settings.title }}</h3>
          <p class="le-steps__body">{{ block.settings.body }}</p>
        </div>
      {%- endfor -%}
    </div>
    {%- if s.cta_text != blank -%}
      <div class="le-steps__cta"><a href="{{ s.cta_link | default: '/collections/all' }}" class="le-btn">{{ s.cta_text }}</a></div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "LE How It Works",
  "tag": "section",
  "class": "t4s-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From our kitchen to your table" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Start your order" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#dff5d8" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon / emoji", "default": "🛒" },
        { "type": "text", "id": "title", "label": "Title", "default": "Pick your favorites" },
        { "type": "textarea", "id": "body", "label": "Description", "default": "Choose from samosas, rolls, kebabs, pockets and more." }
      ]
    }
  ],
  "presets": [{ "name": "LE How It Works", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
