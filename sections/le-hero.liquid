{% liquid
  assign s = section.settings
  assign sid = section.id
%}

<style>
  #le-hero-{{ sid }} {
    background-color: {{ s.bg_color }};
    padding: 60px 0 50px;
  }
  #le-hero-{{ sid }} .le-hero__wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  #le-hero-{{ sid }} .le-hero__text {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  #le-hero-{{ sid }} .le-hero__stars {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: "Work Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 16px;
    color: rgba(0, 31, 16, 0.949);
  }
  #le-hero-{{ sid }} .le-hero__stars .stars {
    color: {{ s.accent_color }};
    font-size: 18px;
    letter-spacing: 1px;
  }
  #le-hero-{{ sid }} .le-hero__heading {
    font-family: "Work Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 56px;
    font-weight: 800;
    line-height: 1.1;
    color: rgba(0, 31, 16, 0.949);
    margin: 0;
  }
  #le-hero-{{ sid }} .le-hero__heading em {
    font-style: normal;
    color: {{ s.accent_color }};
  }
  #le-hero-{{ sid }} .le-hero__cta-wrap {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  #le-hero-{{ sid }} .le-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #007E40;
    color: #ffffff;
    font-family: "Work Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 18px;
    font-weight: 700;
    padding: 0 32px;
    height: 56px;
    border-radius: 9999px;
    text-decoration: none;
    width: fit-content;
    letter-spacing: 0.3px;
    transition: opacity 0.2s;
  }
  #le-hero-{{ sid }} .le-hero__btn:hover { opacity: 0.85; }
  #le-hero-{{ sid }} .le-hero__microtrust {
    display: flex;
    align-items: center;
    gap: 18px;
    font-size: 12px;
    color: #666;
  }
  #le-hero-{{ sid }} .le-hero__microtrust span {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  #le-hero-{{ sid }} .le-hero__stats {
    display: flex;
    gap: 28px;
    margin-top: 4px;
  }
  #le-hero-{{ sid }} .le-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
  }
  #le-hero-{{ sid }} .le-stat__circle {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: {{ s.stat_circle_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    font-weight: 900;
    color: #1a1a1a;
    line-height: 1;
  }
  #le-hero-{{ sid }} .le-stat__label {
    font-size: 13px;
    font-weight: 700;
    color: #1a1a1a;
    line-height: 1.2;
  }
  #le-hero-{{ sid }} .le-stat__sub {
    font-size: 11px;
    color: #666;
    line-height: 1.3;
    max-width: 80px;
  }
  #le-hero-{{ sid }} .le-hero__image-wrap {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 4/3;
  }
  #le-hero-{{ sid }} .le-hero__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #le-hero-{{ sid }} .le-hero__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    background: #1a1a1a;
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    text-align: center;
    padding: 12px;
    border-radius: 50%;
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1.3;
    text-transform: uppercase;
    border: 3px solid {{ s.accent_color }};
  }
  @media (max-width: 767px) {
    #le-hero-{{ sid }} {
      padding: 32px 0 40px;
    }
    #le-hero-{{ sid }} .le-hero__wrap {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    #le-hero-{{ sid }} .le-hero__image-wrap {
      order: -1;
      aspect-ratio: 4/3;
      border-radius: 14px;
    }
    #le-hero-{{ sid }} .le-hero__heading {
      font-size: 32px;
    }
    #le-hero-{{ sid }} .le-hero__stats {
      gap: 16px;
    }
    #le-hero-{{ sid }} .le-stat__circle {
      width: 58px;
      height: 58px;
      font-size: 20px;
    }
  }
</style>

<div id="le-hero-{{ sid }}">
  <div class="le-hero__wrap">

    <div class="le-hero__text">

      {%- if s.social_proof != blank -%}
      <div class="le-hero__stars">
        <span class="stars">★★★★★</span>
        <span>{{ s.social_proof }}</span>
      </div>
      {%- endif -%}

      <h1 class="le-hero__heading">
        {{ s.heading }}
        {%- if s.heading_highlight != blank -%}
          <br><em>{{ s.heading_highlight }}</em>
        {%- endif -%}
      </h1>

      <div class="le-hero__cta-wrap">
        <a href="{{ s.cta_link }}" class="le-hero__btn">{{ s.cta_text }}</a>
        {%- if s.trust_1 != blank or s.trust_2 != blank -%}
        <div class="le-hero__microtrust">
          {%- if s.trust_1 != blank -%}<span>✓ {{ s.trust_1 }}</span>{%- endif -%}
          {%- if s.trust_2 != blank -%}<span>✓ {{ s.trust_2 }}</span>{%- endif -%}
        </div>
        {%- endif -%}
      </div>

      <div class="le-hero__stats">
        {%- for i in (1..3) -%}
          {%- liquid
            assign num_key = 'stat_' | append: i | append: '_num'
            assign label_key = 'stat_' | append: i | append: '_label'
            assign sub_key = 'stat_' | append: i | append: '_sub'
            assign num = s[num_key]
            assign label = s[label_key]
            assign sub = s[sub_key]
          -%}
          {%- if num != blank -%}
          <div class="le-stat">
            <div class="le-stat__circle">{{ num }}</div>
            {%- if label != blank -%}<div class="le-stat__label">{{ label }}</div>{%- endif -%}
            {%- if sub != blank -%}<div class="le-stat__sub">{{ sub }}</div>{%- endif -%}
          </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>

    <div class="le-hero__image-wrap">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 900 | image_tag: loading: 'eager', widths: '400,600,900' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
      {%- if s.badge_text != blank -%}
        <div class="le-hero__badge">{{ s.badge_text }}</div>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "LE Hero",
  "tag": "section",
  "class": "t4s-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "social_proof",
      "label": "Social proof line",
      "default": "4.8 stars from 10,000+ reviews • 50,000+ happy customers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Authentic Pakistani Flavors"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Headline highlight (accent color)",
      "default": "Delivered to Your Door"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Order Now"
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust text 1",
      "default": "Free delivery above Rs. 2500"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust text 2",
      "default": "Fresh & frozen daily"
    },
    {
      "type": "header",
      "content": "Stat 1"
    },
    {
      "type": "text",
      "id": "stat_1_num",
      "label": "Number",
      "default": "20+"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Label",
      "default": "Snacks"
    },
    {
      "type": "text",
      "id": "stat_1_sub",
      "label": "Sub-label",
      "default": "Pockets, rolls & more"
    },
    {
      "type": "header",
      "content": "Stat 2"
    },
    {
      "type": "text",
      "id": "stat_2_num",
      "label": "Number",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Label",
      "default": "Halal"
    },
    {
      "type": "text",
      "id": "stat_2_sub",
      "label": "Sub-label",
      "default": "Certified & verified"
    },
    {
      "type": "header",
      "content": "Stat 3"
    },
    {
      "type": "text",
      "id": "stat_3_num",
      "label": "Number",
      "default": "48hr"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Label",
      "default": "Delivery"
    },
    {
      "type": "text",
      "id": "stat_3_sub",
      "label": "Sub-label",
      "default": "Frozen & fresh to you"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text on image (leave blank to hide)",
      "default": "Order Now & Save!"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#fef7f0"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color (stars, highlight, badge border)",
      "default": "#e94949"
    },
    {
      "type": "color",
      "id": "stat_circle_color",
      "label": "Stat circle background",
      "default": "#ffd166"
    }
  ],
  "presets": [
    {
      "name": "LE Hero"
    }
  ]
}
{% endschema %}
