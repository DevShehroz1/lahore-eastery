{%- assign s = section.settings -%}
<style>
  #le-cat-{{ section.id }} { background: {{ s.bg_color }}; }
  #le-cat-{{ section.id }} .le-cat__grid { display: grid; grid-template-columns: repeat({{ s.columns }}, minmax(0, 1fr)); gap: 20px; }
  #le-cat-{{ section.id }} .le-cat__tile { display: block; text-decoration: none; color: var(--le-ink); text-align: center; }
  #le-cat-{{ section.id }} .le-cat__img { position: relative; aspect-ratio: 1 / 1; border-radius: var(--le-radius); overflow: hidden; background: var(--le-blush); }
  #le-cat-{{ section.id }} .le-cat__img img, #le-cat-{{ section.id }} .le-cat__img svg { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s ease; }
  #le-cat-{{ section.id }} .le-cat__tile:hover img { transform: scale(1.05); }
  #le-cat-{{ section.id }} .le-cat__title { display: inline-flex; align-items: center; gap: 6px; margin-top: 14px; font-size: 18px; font-weight: 700; }
  #le-cat-{{ section.id }} .le-cat__arrow { transition: transform .2s ease; }
  #le-cat-{{ section.id }} .le-cat__tile:hover .le-cat__arrow { transform: translateX(4px); }
  @media (max-width: 989px) { #le-cat-{{ section.id }} .le-cat__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 767px) {
    #le-cat-{{ section.id }} .le-cat__grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 12px; margin: 0 -16px; padding: 0 16px 8px; scrollbar-width: none; }
    #le-cat-{{ section.id }} .le-cat__grid::-webkit-scrollbar { display: none; }
    #le-cat-{{ section.id }} .le-cat__tile { flex: 0 0 42%; scroll-snap-align: start; }
    #le-cat-{{ section.id }} .le-cat__title { font-size: 15px; }
  }
</style>
<div id="le-cat-{{ section.id }}" class="le-sec">
  <div class="le-wrap">
    <div class="le-head le-center">
      {%- if s.eyebrow != blank -%}<p class="le-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="le-h2">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.subheading != blank -%}<p class="le-lead">{{ s.subheading }}</p>{%- endif -%}
    </div>
    <div class="le-cat__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign col = b.collection
          assign url = b.link | default: col.url | default: '/collections/all'
          assign title = b.title | default: col.title
          assign img = b.image | default: col.featured_image
        -%}
        <a href="{{ url }}" class="le-cat__tile" {{ block.shopify_attributes }}>
          <div class="le-cat__img">
            {%- if img != blank -%}
              {{ img | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(max-width: 767px) 42vw, 20vw', alt: title }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <span class="le-cat__title">{{ title }} <span class="le-cat__arrow" aria-hidden="true">→</span></span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "LE Category Tiles",
  "tag": "section",
  "class": "t4s-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by craving" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "All the flavors you love" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 3, "max": 6, "step": 1, "default": 5 },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (overrides collection image)" },
        { "type": "text", "id": "title", "label": "Title (overrides collection title)" },
        { "type": "url", "id": "link", "label": "Link (overrides collection link)" }
      ]
    }
  ],
  "presets": [{ "name": "LE Category Tiles", "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }] }]
}
{% endschema %}
