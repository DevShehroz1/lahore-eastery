{% liquid
  assign s = section.settings
  assign sid = section.id
%}

<style>
  #le-sp-{{ sid }} {
    background: {{ s.bg_color }};
    border-top: 1px solid rgba(0,0,0,0.08);
    border-bottom: 1px solid rgba(0,0,0,0.08);
    padding: 18px 24px;
  }
  #le-sp-{{ sid }} .le-sp__inner {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    flex-wrap: wrap;
  }
  #le-sp-{{ sid }} .le-sp__item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 32px;
    font-family: "Work Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 15px;
    color: rgba(0,31,16,0.85);
  }
  #le-sp-{{ sid }} .le-sp__item + .le-sp__item {
    border-left: 1.5px solid rgba(0,31,16,0.15);
  }
  #le-sp-{{ sid }} .le-sp__icon {
    font-size: 20px;
    line-height: 1;
  }
  #le-sp-{{ sid }} .le-sp__num {
    font-weight: 800;
    font-size: 17px;
    color: {{ s.accent_color }};
  }
  @media (max-width: 600px) {
    #le-sp-{{ sid }} .le-sp__item {
      padding: 6px 16px;
      font-size: 13px;
    }
    #le-sp-{{ sid }} .le-sp__num { font-size: 15px; }
  }
</style>

<div id="le-sp-{{ sid }}">
  <div class="le-sp__inner">
    <div class="le-sp__item">
      <span class="le-sp__icon">⭐</span>
      <span><span class="le-sp__num">{{ s.stat1_num }}</span> {{ s.stat1_label }}</span>
    </div>
    <div class="le-sp__item">
      <span class="le-sp__icon">{{ s.stat2_icon }}</span>
      <span><span class="le-sp__num">{{ s.stat2_num }}</span> {{ s.stat2_label }}</span>
    </div>
    <div class="le-sp__item">
      <span class="le-sp__icon">{{ s.stat3_icon }}</span>
      <span><span class="le-sp__num">{{ s.stat3_num }}</span> {{ s.stat3_label }}</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "LE Social Proof Bar",
  "tag": "section",
  "class": "t4s-section",
  "settings": [
    { "type": "text", "id": "stat1_num", "label": "Stat 1 number", "default": "4.8 stars" },
    { "type": "text", "id": "stat1_label", "label": "Stat 1 label", "default": "from 5,000+ reviews" },
    { "type": "text", "id": "stat2_icon", "label": "Stat 2 emoji/icon", "default": "🚚" },
    { "type": "text", "id": "stat2_num", "label": "Stat 2 number", "default": "50,000+" },
    { "type": "text", "id": "stat2_label", "label": "Stat 2 label", "default": "orders delivered" },
    { "type": "text", "id": "stat3_icon", "label": "Stat 3 emoji/icon", "default": "✅" },
    { "type": "text", "id": "stat3_num", "label": "Stat 3 number", "default": "100%" },
    { "type": "text", "id": "stat3_label", "label": "Stat 3 label", "default": "Halal certified" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent (numbers)", "default": "#e94949" }
  ],
  "presets": [{ "name": "LE Social Proof Bar" }]
}
{% endschema %}
