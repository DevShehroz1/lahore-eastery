{%- assign s = section.settings -%}
<style>
  #le-mq-{{ section.id }} { background: {{ s.bg_color }}; color: {{ s.text_color }}; overflow: hidden; padding: 16px 0; font-family: var(--le-font); }
  #le-mq-{{ section.id }} .le-mq__track { display: flex; width: max-content; animation: le-mq {{ s.speed }}s linear infinite; }
  #le-mq-{{ section.id }}:hover .le-mq__track { animation-play-state: paused; }
  #le-mq-{{ section.id }} .le-mq__item { display: inline-flex; align-items: center; gap: 12px; padding: 0 28px; font-size: 18px; font-weight: 700; white-space: nowrap; }
  #le-mq-{{ section.id }} .le-mq__dot { opacity: .6; }
  @keyframes le-mq { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { #le-mq-{{ section.id }} .le-mq__track { animation: none; } }
  @media (max-width: 767px) { #le-mq-{{ section.id }} .le-mq__item { font-size: 15px; padding: 0 18px; } }
</style>
<div id="le-mq-{{ section.id }}" aria-label="{{ s.aria_label | escape }}">
  <div class="le-mq__track">
    {%- for n in (1..4) -%}
      {%- for block in section.blocks -%}
        <span class="le-mq__item" {{ block.shopify_attributes }}{% if n > 1 %} aria-hidden="true"{% endif %}>
          {%- if block.settings.icon != blank -%}<span>{{ block.settings.icon }}</span>{%- endif -%}
          {{ block.settings.text }}
          <span class="le-mq__dot">✦</span>
        </span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "LE Marquee",
  "tag": "section",
  "class": "t4s-section",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Accessible label", "default": "Why customers love us" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#e94949" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "range", "id": "speed", "label": "Loop duration (seconds)", "min": 10, "max": 80, "step": 5, "default": 35 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon / emoji" },
        { "type": "text", "id": "text", "label": "Text", "default": "100% Halal" }
      ]
    }
  ],
  "presets": [{ "name": "LE Marquee", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
