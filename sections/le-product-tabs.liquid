{%- assign s = section.settings -%}
<style>
  #le-pt-{{ section.id }} { background: {{ s.bg_color }}; }
  #le-pt-{{ section.id }} .le-pt__tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-bottom: 40px; }
  #le-pt-{{ section.id }} .le-pt__tab { font-family: var(--le-font); font-size: 16px; font-weight: 700; height: 44px; padding: 0 22px; border-radius: 9999px; border: 2px solid var(--le-ink); background: transparent; color: var(--le-ink); cursor: pointer; transition: background .2s, color .2s; }
  #le-pt-{{ section.id }} .le-pt__tab[aria-selected="true"], #le-pt-{{ section.id }} .le-pt__tab:hover { background: var(--le-ink); color: #fff; }
  #le-pt-{{ section.id }} .le-pt__panel[hidden] { display: none; }
  #le-pt-{{ section.id }} .le-pt__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  #le-pt-{{ section.id }} .le-pc { display: flex; flex-direction: column; background: #fff; border-radius: var(--le-radius); overflow: hidden; box-shadow: 0 1px 0 rgba(43,17,17,.08); transition: transform .2s ease, box-shadow .2s ease; }
  #le-pt-{{ section.id }} .le-pc:hover { transform: translateY(-4px); box-shadow: 0 16px 32px rgba(43,17,17,.1); }
  #le-pt-{{ section.id }} .le-pc__media { position: relative; display: block; aspect-ratio: 1 / 1; background: var(--le-blush); overflow: hidden; }
  #le-pt-{{ section.id }} .le-pc__media img, #le-pt-{{ section.id }} .le-pc__media svg { width: 100%; height: 100%; object-fit: cover; display: block; }
  #le-pt-{{ section.id }} .le-pc__badge { position: absolute; top: 12px; left: 12px; background: var(--le-yellow); color: var(--le-ink); font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .5px; padding: 6px 12px; border-radius: 9999px; }
  #le-pt-{{ section.id }} .le-pc__body { display: flex; flex-direction: column; gap: 8px; padding: 18px 18px 20px; flex: 1; }
  #le-pt-{{ section.id }} .le-pc__rating { font-size: 13px; color: var(--le-ink-soft); }
  #le-pt-{{ section.id }} .le-pc__title { font-size: 18px; font-weight: 700; line-height: 1.25; color: var(--le-ink); text-decoration: none; margin: 0; }
  #le-pt-{{ section.id }} .le-pc__price { display: flex; align-items: baseline; gap: 8px; font-size: 17px; font-weight: 700; margin-top: auto; padding-top: 4px; }
  #le-pt-{{ section.id }} .le-pc__compare { font-size: 14px; font-weight: 500; color: var(--le-ink-soft); text-decoration: line-through; }
  #le-pt-{{ section.id }} .le-pc form { margin: 6px 0 0; }
  #le-pt-{{ section.id }} .le-pc .le-btn[disabled] { background: #d9c3c0; cursor: not-allowed; transform: none; }
  #le-pt-{{ section.id }} .le-pt__more { text-align: center; margin-top: 40px; }
  @media (max-width: 989px) { #le-pt-{{ section.id }} .le-pt__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 767px) {
    #le-pt-{{ section.id }} .le-pt__tabs { flex-wrap: nowrap; justify-content: flex-start; overflow-x: auto; margin: 0 -16px 28px; padding: 0 16px 4px; scrollbar-width: none; }
    #le-pt-{{ section.id }} .le-pt__tabs::-webkit-scrollbar { display: none; }
    #le-pt-{{ section.id }} .le-pt__tab { flex: 0 0 auto; font-size: 14px; height: 40px; padding: 0 16px; }
    #le-pt-{{ section.id }} .le-pt__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    #le-pt-{{ section.id }} .le-pc__body { padding: 12px 12px 14px; gap: 6px; }
    #le-pt-{{ section.id }} .le-pc__title { font-size: 15px; }
    #le-pt-{{ section.id }} .le-pc__price { font-size: 15px; }
    #le-pt-{{ section.id }} .le-pc .le-btn { height: 40px; font-size: 14px; padding: 0 12px; }
  }
</style>
<div id="le-pt-{{ section.id }}" class="le-sec">
  <div class="le-wrap">
    <div class="le-head le-center">
      {%- if s.eyebrow != blank -%}<p class="le-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="le-h2">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.subheading != blank -%}<p class="le-lead">{{ s.subheading }}</p>{%- endif -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="le-pt__tabs" role="tablist">
        {%- for block in section.blocks -%}
          <button type="button" class="le-pt__tab" role="tab" id="le-pt-tab-{{ block.id }}" aria-controls="le-pt-panel-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
            {{ block.settings.label | default: block.settings.collection.title }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- assign col = block.settings.collection -%}
      <div class="le-pt__panel" role="tabpanel" id="le-pt-panel-{{ block.id }}" aria-labelledby="le-pt-tab-{{ block.id }}"{% unless forloop.first %} hidden{% endunless %}>
        <div class="le-pt__grid">
          {%- if col != blank and col.products_count > 0 -%}
            {%- for product in col.products limit: s.limit -%}
              {%- assign variant = product.selected_or_first_available_variant -%}
              <div class="le-pc">
                <a href="{{ product.url }}" class="le-pc__media">
                  {%- if product.featured_media -%}
                    {{ product.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(max-width: 767px) 50vw, 25vw', alt: product.title }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {%- endif -%}
                  {%- if product.compare_at_price > product.price -%}
                    <span class="le-pc__badge">Save {{ product.compare_at_price | minus: product.price | money_without_trailing_zeros }}</span>
                  {%- elsif forloop.index <= s.bestseller_count -%}
                    <span class="le-pc__badge">{{ s.badge_text }}</span>
                  {%- endif -%}
                </a>
                <div class="le-pc__body">
                  {%- if s.rating_text != blank -%}<div class="le-pc__rating"><span class="le-stars">★★★★★</span> {{ s.rating_text }}</div>{%- endif -%}
                  <a href="{{ product.url }}" class="le-pc__title">{{ product.title }}</a>
                  <div class="le-pc__price">
                    <span>{{ product.price | money }}</span>
                    {%- if product.compare_at_price > product.price -%}<span class="le-pc__compare">{{ product.compare_at_price | money }}</span>{%- endif -%}
                  </div>
                  {%- if product.has_only_default_variant or product.variants.size == 1 -%}
                    <form method="post" action="{{ routes.cart_add_url }}" class="le-pc__form" data-le-atc>
                      <input type="hidden" name="id" value="{{ variant.id }}">
                      <input type="hidden" name="quantity" value="1">
                      <button type="submit" class="le-btn le-btn--sm le-btn--block"{% unless product.available %} disabled{% endunless %}>
                        {%- if product.available -%}{{ s.atc_text }}{%- else -%}Sold out{%- endif -%}
                      </button>
                    </form>
                  {%- else -%}
                    <a href="{{ product.url }}" class="le-btn le-btn--sm le-btn--block">Choose options</a>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              <div class="le-pc">
                <div class="le-pc__media">{{ 'product-' | append: i | placeholder_svg_tag }}</div>
                <div class="le-pc__body"><p class="le-pc__title">Pick a collection</p><div class="le-pc__price">Rs. 0</div></div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
        {%- if col != blank and s.view_all_text != blank -%}
          <div class="le-pt__more"><a href="{{ col.url }}" class="le-btn">{{ s.view_all_text }} {{ block.settings.label | default: col.title }}</a></div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>
<script>
  (function () {
    var root = document.getElementById('le-pt-{{ section.id }}');
    if (!root) return;
    var tabs = root.querySelectorAll('.le-pt__tab');
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        tabs.forEach(function (t) {
          var on = t === tab;
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          var panel = document.getElementById(t.getAttribute('aria-controls'));
          if (panel) panel.hidden = !on;
        });
      });
    });
    root.querySelectorAll('form[data-le-atc]').forEach(function (form) {
      form.addEventListener('submit', function (e) {
        if (!window.fetch) return;
        e.preventDefault();
        var btn = form.querySelector('button');
        var label = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Adding…';
        fetch('{{ routes.cart_add_url }}.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ items: [{ id: Number(form.querySelector('[name="id"]').value), quantity: 1 }] })
        })
          .then(function (r) { if (!r.ok) throw r; return r.json(); })
          .then(function () {
            btn.textContent = 'Added ✓';
            document.dispatchEvent(new CustomEvent('cart:refresh:opend'));
          })
          .catch(function () { btn.textContent = 'Try again'; })
          .finally(function () {
            setTimeout(function () { btn.disabled = false; btn.textContent = label; }, 1800);
          });
      });
    });
  })();
</script>
{% schema %}
{
  "name": "LE Product Tabs",
  "tag": "section",
  "class": "t4s-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your new favorite snack" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "range", "id": "limit", "label": "Products per tab", "min": 4, "max": 12, "step": 4, "default": 8 },
    { "type": "text", "id": "rating_text", "label": "Rating text on cards", "default": "4.8" },
    { "type": "text", "id": "badge_text", "label": "Bestseller badge text", "default": "Bestseller" },
    { "type": "range", "id": "bestseller_count", "label": "Show bestseller badge on first N products", "min": 0, "max": 4, "step": 1, "default": 2 },
    { "type": "text", "id": "atc_text", "label": "Add to cart text", "default": "Add to cart" },
    { "type": "text", "id": "view_all_text", "label": "View all button prefix", "default": "Shop all" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#faf6e4" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Collection tab",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Tab label (defaults to collection title)" }
      ]
    }
  ],
  "presets": [{ "name": "LE Product Tabs", "blocks": [{ "type": "tab" }, { "type": "tab" }] }]
}
{% endschema %}
