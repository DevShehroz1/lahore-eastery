{%- assign s = section.settings -%}
<style>
  #le-rv-{{ section.id }} { background: {{ s.bg_color }}; }
  #le-rv-{{ section.id }} .le-rv__summary { display: inline-flex; align-items: center; gap: 10px; font-size: 16px; font-weight: 600; margin-top: 8px; }
  #le-rv-{{ section.id }} .le-rv__summary .le-stars { font-size: 20px; }
  #le-rv-{{ section.id }} .le-rv__track { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 48px) / 3); gap: 24px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; padding-bottom: 8px; scrollbar-width: none; }
  #le-rv-{{ section.id }} .le-rv__track::-webkit-scrollbar { display: none; }
  #le-rv-{{ section.id }} .le-rv__card { scroll-snap-align: start; background: #fff; border-radius: var(--le-radius); padding: 28px; display: flex; flex-direction: column; gap: 14px; }
  #le-rv-{{ section.id }} .le-rv__title { font-size: 20px; font-weight: 800; margin: 0; }
  #le-rv-{{ section.id }} .le-rv__body { font-size: 16px; line-height: 1.6; color: var(--le-ink-soft); margin: 0; flex: 1; }
  #le-rv-{{ section.id }} .le-rv__author { display: flex; align-items: center; gap: 12px; font-size: 15px; font-weight: 700; }
  #le-rv-{{ section.id }} .le-rv__avatar { width: 44px; height: 44px; border-radius: 50%; overflow: hidden; background: var(--le-green); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; }
  #le-rv-{{ section.id }} .le-rv__avatar img { width: 100%; height: 100%; object-fit: cover; }
  #le-rv-{{ section.id }} .le-rv__verified { display: block; font-size: 12px; font-weight: 600; color: var(--le-green); }
  #le-rv-{{ section.id }} .le-rv__nav { display: flex; justify-content: center; gap: 12px; margin-top: 28px; }
  #le-rv-{{ section.id }} .le-rv__arrow { width: 48px; height: 48px; border-radius: 50%; border: 2px solid var(--le-ink); background: transparent; color: var(--le-ink); font-size: 20px; cursor: pointer; }
  #le-rv-{{ section.id }} .le-rv__arrow:hover { background: var(--le-ink); color: #fff; }
  @media (max-width: 989px) { #le-rv-{{ section.id }} .le-rv__track { grid-auto-columns: calc((100% - 24px) / 2); } }
  @media (max-width: 767px) {
    #le-rv-{{ section.id }} .le-rv__track { grid-auto-columns: 85%; gap: 12px; margin: 0 -16px; padding: 0 16px 8px; scroll-padding: 0 16px; }
    #le-rv-{{ section.id }} .le-rv__card { padding: 22px; }
  }
</style>
<div id="le-rv-{{ section.id }}" class="le-sec">
  <div class="le-wrap">
    <div class="le-head le-center">
      {%- if s.eyebrow != blank -%}<p class="le-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="le-h2">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.summary != blank -%}<div class="le-rv__summary"><span class="le-stars">★★★★★</span> {{ s.summary }}</div>{%- endif -%}
    </div>
    <div class="le-rv__track" data-le-track>
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="le-rv__card" {{ block.shopify_attributes }}>
          <span class="le-stars" aria-label="{{ b.rating }} out of 5 stars">{% for i in (1..b.rating) %}★{% endfor %}</span>
          {%- if b.title != blank -%}<p class="le-rv__title">“{{ b.title }}”</p>{%- endif -%}
          <p class="le-rv__body">{{ b.body }}</p>
          <div class="le-rv__author">
            <span class="le-rv__avatar">
              {%- if b.avatar != blank -%}{{ b.avatar | image_url: width: 100 | image_tag: loading: 'lazy', alt: b.author }}{%- else -%}{{ b.author | slice: 0 }}{%- endif -%}
            </span>
            <span>{{ b.author }}{%- if b.location != blank -%}, {{ b.location }}{%- endif -%}<span class="le-rv__verified">✓ Verified buyer</span></span>
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > 3 -%}
      <div class="le-rv__nav">
        <button type="button" class="le-rv__arrow" data-dir="-1" aria-label="Previous reviews">←</button>
        <button type="button" class="le-rv__arrow" data-dir="1" aria-label="Next reviews">→</button>
      </div>
    {%- endif -%}
  </div>
</div>
<script>
  (function () {
    var root = document.getElementById('le-rv-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('[data-le-track]');
    root.querySelectorAll('.le-rv__arrow').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var card = track.querySelector('.le-rv__card');
        var step = card ? card.getBoundingClientRect().width + 24 : track.clientWidth;
        track.scrollBy({ left: step * Number(btn.dataset.dir), behavior: 'smooth' });
      });
    });
  })();
</script>
{% schema %}
{
  "name": "LE Reviews",
  "tag": "section",
  "class": "t4s-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 50,000+ families" },
    { "type": "text", "id": "summary", "label": "Rating summary", "default": "4.8 out of 5 from 5,000+ reviews" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#faf6e4" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Title", "default": "Tastes just like home" },
        { "type": "textarea", "id": "body", "label": "Review", "default": "The samosas are crispy, the filling is perfect. My kids ask for them every day." },
        { "type": "text", "id": "author", "label": "Name", "default": "Ayesha K." },
        { "type": "text", "id": "location", "label": "City", "default": "Lahore" },
        { "type": "image_picker", "id": "avatar", "label": "Photo" }
      ]
    }
  ],
  "presets": [{ "name": "LE Reviews", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
